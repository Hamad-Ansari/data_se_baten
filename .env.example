# DATA_SE_BATEN — copy to .env and adjust.
# Every value can also be changed at runtime from the Settings page
# (persisted to config/user_settings.json).

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- directories (defaults are relative to the project root) --------------
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
PROCESSED_DIR=./data/processed
SAMPLES_DIR=./data/samples
MODELS_DIR=./models
REPORTS_DIR=./reports
KNOWLEDGE_DIR=./data/knowledge
LOG_DIR=./logs

# --- uploads --------------------------------------------------------------
MAX_FILE_SIZE_MB=200
ALLOWED_EXTENSIONS=.csv,.tsv,.txt,.xlsx,.xls,.json,.jsonl,.parquet,.zip

# --- API / UI -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=*
FRONTEND_BASE_URL=http://localhost:8501

# --- LLM (optional) -------------------------------------------------------
ENABLE_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.2

# --- modelling ------------------------------------------------------------
RANDOM_STATE=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.1
CV_FOLDS=5

# --- AutoML budget --------------------------------------------------------
AUTOML_MAX_CANDIDATES=4
AUTOML_TIME_BUDGET_SECONDS=900
OPTUNA_ENABLED=true
OPTUNA_TRIALS=30
OPTUNA_TIMEOUT_SECONDS=300

# --- quality gate ---------------------------------------------------------
GATE_MIN_PRIMARY_SCORE=0.0
GATE_MIN_IMPROVEMENT_OVER_BASELINE=0.20
GATE_MAX_OVERFIT_GAP=0.20
GATE_MAX_LATENCY_MS=300
GATE_REQUIRE_BEATS_BASELINE=true
GATE_MAX_RETRIES=2

# --- agent ----------------------------------------------------------------
AGENT_MAX_RETRIES=2
AGENT_REQUIRE_HUMAN_APPROVAL=true
AGENT_AUTO_CLEAN=true
AGENT_CHAT_HISTORY_LIMIT=40

# --- monitoring -----------------------------------------------------------
MONITORING_PSI_WARNING=0.10
MONITORING_PSI_ALERT=0.20
MONITORING_RETRAIN_MIN_NEW_SAMPLES=100
